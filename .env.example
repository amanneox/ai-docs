# Database
# For local (non-Docker) dev, point this at your own Postgres.
# Under `docker compose`, this is AUTO-OVERRIDDEN to the db service — no need to change it.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_docs"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Liveblocks for Real-time Collaboration
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_dev_
LIVEBLOCKS_SECRET_KEY=sk_dev_

# Google Gemini for AI Features (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
